<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Console appender for local dev (includes traceId from MDC) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} traceId=%X{traceId} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- JSON file appender for application logs -->
  <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="APP_FILE"/>
  </root>

  <logger name="com.fitnessapp" level="INFO"/>
  <logger name="org.springframework.web" level="WARN"/>
  <logger name="org.hibernate.SQL" level="WARN"/>

</configuration>
